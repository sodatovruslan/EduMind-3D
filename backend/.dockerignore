# Критично: локальный .env не должен попасть в образ — переменные на хостинге
# задаются через его собственный интерфейс, а секреты из образа утекают вместе
# с ним. Пересборка образа с чужим SECRET_KEY/паролем БД — худший вид сюрприза.
.env
.env.example

.venv
venv
__pycache__/
*.pyc
.pytest_cache/
*.db
*.log

tests/
pytest.ini
